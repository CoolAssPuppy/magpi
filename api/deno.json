{
  "tasks": {
    "test": "deno test --allow-env --allow-net supabase/functions/",
    "test:coverage": "deno test --allow-env --allow-net --coverage=coverage supabase/functions/ && deno coverage coverage",
    "check": "deno check supabase/functions/**/*.ts",
    "lint": "deno lint supabase/functions/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@supabase/supabase-js": "jsr:@supabase/supabase-js@^2.45.4",
    "zod": "jsr:@zod/zod@^4.0.17"
  },
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  }
}
